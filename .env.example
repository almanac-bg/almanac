# Copy to .env on the server and fill in.
DOMAIN=almanac.bg

# Email for password resets and address verification. Use port 587 (Hetzner blocks outgoing 25 and 465).
# e.g. Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=АЛМАНАХ <no-reply@almanac.bg>

# Seconds a quick-match waits for humans before bots fill the seats ("off" disables bots).
BOT_FILL_SECONDS=8
# Ranked queues open to players. Few queues while few people play, so they meet each other instead of bots;
# open more as the game grows (duel, teams, trio, squad, royale — or "all").
PUBLIC_QUEUES=duel,royale

# Error reports (optional, recommended): a Sentry project's DSN. Create the organization in the EU region (Frankfurt).
SENTRY_DSN=

# Continuous off-site backups with Litestream (keep this on): every change reaches object storage within seconds.
# Create a bucket in Hetzner Object Storage (Cloud Console → Object Storage) and S3 credentials for it.
COMPOSE_PROFILES=backup
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://fsn1.your-objectstorage.com
# The location in the endpoint above (fsn1, nbg1 or hel1); for Cloudflare R2 use "auto".
BACKUP_REGION=fsn1
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
