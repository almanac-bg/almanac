# Copy to .env on the server and fill in.
DOMAIN=almanac.bg

# Moderators (comma-separated usernames) — put your own username here. In production nobody becomes an admin
# just by registering first.
ADMIN_USERNAMES=

# Email for password resets and address verification. Use port 587 (Hetzner blocks outgoing 25 and 465).
# e.g. Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=АЛМАНАХ <no-reply@almanac.bg>

# Seconds a quick-match waits for humans before bots fill the seats ("off" disables bots).
BOT_FILL_SECONDS=8

# Optional backups (docker compose --profile backup up -d), e.g. Hetzner Object Storage:
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
