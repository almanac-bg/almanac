# Copy to .env on the server and fill in.
DOMAIN=almanac.bg
# The image deploy/deploy.sh pulls (CI publishes ghcr.io/<owner>/<repository>:<commit>): a fork's own, or empty for
# ghcr.io/almanac-bg/almanac.
IMAGE=
# Optional: "; preload" asks browsers to use HTTPS for the domain and every subdomain even on a first visit, once the
# domain is submitted at https://hstspreload.org. Hard to undo (months): only for a domain whose every subdomain is
# HTTPS for good.
HSTS_PRELOAD=

# Who runs the site: shown in the privacy policy and terms (required by GDPR). Personal details live here, never in
# the code.
OPERATOR_NAME=
# Optional: a correspondence address (e.g. a P.O. box, never needed as a home address). Without it, the legal pages
# give the email below as the way to reach you. A site that earns money (ads, payments) needs one (ЗЕТ чл. 4).
OPERATOR_ADDRESS=
CONTACT_EMAIL=privacy@almanac.bg
# The services that handle data for the site, as the privacy policy names them.
EMAIL_PROVIDER=Scaleway SAS, Франция
HOSTING_PROVIDER=Hetzner Online GmbH, Германия
# Cloudflare's proxy in front of the server (docs/self-hosting.md, step 2): every connection passes through it, so the
# policy names it, and the cookie it sets after a bot check. Leave empty while the records are DNS only.
PROXY_PROVIDER=Cloudflare, Inc., САЩ (сертифицирана по Рамката за защита на данните между ЕС и САЩ)
# Where the off-site backups are (leave empty if it's the hosting provider) and who forwards mail to CONTACT_EMAIL.
BACKUP_PROVIDER=Cloudflare, Inc., САЩ (сертифицирана по Рамката за защита на данните между ЕС и САЩ; данни в ЕС)
INBOX_PROVIDER=Cloudflare, Inc., САЩ (Email Routing; сертифицирана по Рамката за защита на данните между ЕС и САЩ)
# Where that mail ends up: the mailbox provider (leave empty if the inbox above is it).
MAILBOX_PROVIDER=
# Web push (Settings → „Известия на телефона“): a key pair of this site's own. Make it on the server, straight into
# .env, so the private key is never on screen:
#   docker compose exec -T app node apps/server/dist/cli.mjs vapid-keys >> .env
# then the deploy command. Leave both empty for no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where the source code is published (linked in the footer as "Изходен код").
SOURCE_URL=https://github.com/almanac-bg/almanac

# Email for password resets, address verification and streak reminders. Use port 587 (Hetzner blocks outgoing 25 and
# 465). Scaleway Transactional Email: the user is the Project ID, the password an IAM API key's secret key.
# e.g. smtp://PROJECT_ID:SECRET_KEY@smtp.tem.scaleway.com:587
SMTP_URL=
MAIL_FROM=АЛМАНАХ <no-reply@almanac.bg>
# The secret in the address Scaleway posts delivery reports to: /api/email-events/<this> (docs/self-hosting.md → Имейли, step 4).
# e.g. `openssl rand -hex 24`; empty turns the endpoint off.
EMAIL_EVENTS_SECRET=

# Seconds a quick-match waits for humans before bots fill the seats ("off" disables bots)…
BOT_FILL_SECONDS=8
# …and while someone else is online and free to join (not in a match, a queue or a room): worth waiting for a person.
BOT_FILL_BUSY_SECONDS=20
# Ranked queues open to players: "all" (the default), or a list of duel, teams, squad, royale to close the others.
PUBLIC_QUEUES=all
# When the evening Роял starts, Sofia time (HH:MM; empty: 21:00), or "off".
EVENING_AT=
# How many daily copies of the database the server keeps beside it (empty: 3; each is a whole copy on the same disk).
BACKUP_KEEP_DAYS=

# Error reports (optional, recommended): a Sentry project's DSN. Create the organization in the EU region (Frankfurt).
# The server's log goes there too (Logs, kept 30 days; no names, email or IP addresses): "off" keeps it on the server.
SENTRY_DSN=
SENTRY_LOGS=

# Continuous off-site backups with Litestream (keep this on): every change reaches object storage within seconds.
# Kept with another company than the server's, so no one account problem loses both. Cloudflare R2: a bucket with
# the EU jurisdiction, and an R2 API token with Object Read & Write for it. (Hetzner Object Storage works too:
# https://fsn1.your-objectstorage.com, region fsn1.)
COMPOSE_PROFILES=backup
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
BACKUP_REGION=auto
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
