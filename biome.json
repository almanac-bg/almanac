{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["web/**", "e2e/**", "*.json", "!internal/assets/dist", "!bank", "!private"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "linter": { "enabled": true },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
