# /etc/almanac/env — the game's settings on the server (mode 640, root:almanac). Every one: cmd/almanac/serve.go.
# ADDR is where to listen when systemd doesn't hand the port over (almanac.socket does).
ADDR=:443
PUBLIC_URL=https://almanac.bg
DB_PATH=/var/lib/almanac/almanac.db
# The bank's clone (almanac-bank pulls it); the server plays copies of it, kept beside the database.
BANK_DIR=/srv/almanac-bank
TLS_CERT=/etc/almanac/origin.pem
TLS_KEY=/etc/almanac/origin.key
TRUST_CLOUDFLARE=1
# 32+ random characters: openssl rand -base64 48
SECRET=
SMTP_URL=smtp://user:password@smtp.tem.scaleway.com:587
MAIL_FROM=АЛМАНАХ <no-reply@almanac.bg>
OPERATOR_NAME=
CONTACT_EMAIL=privacy@almanac.bg
# Where problems are mailed
ALERT_EMAIL=
# Notifications to browsers: almanac push keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
# The mail policy at mta-sts.<domain>, while the _mta-sts TXT record points to it: testing, then enforce once the
# TLS reports (to postmaster@) are clean. Senders take a changed policy only once that record's id changes: change the
# id after the server serves the new policy, never before.
MTA_STS_MX=mail.protonmail.ch,mailsec.protonmail.ch
MTA_STS_MODE=testing
# Copies of the database in R2 every 15 minutes (README: Резервни копия). The token: Object Read & Write on this bucket only,
# filtered to the server's addresses; the bucket's lifecycle and lock rules keep the copies, not this key.
BACKUP_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
BACKUP_BUCKET=almanac-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_HEARTBEAT=
# The public key the copies are encrypted to (age1pq1…): make the pair OFF the server, `almanac backup keys` (or
# age-keygen -pq). Its secret half (AGE-SECRET-KEY-PQ-1…) opens every copy: keep it off the server, in a password
# manager and once more offline, and never here. Without this, the copies go unencrypted and the server says so daily.
BACKUP_RECIPIENT=
