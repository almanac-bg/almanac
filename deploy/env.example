# /etc/almanac/env — the game's settings on the server (mode 640, root:almanac). Every one: cmd/almanac/serve.go.
ADDR=:443
PUBLIC_URL=https://almanac.bg
DB_PATH=/var/lib/almanac/almanac.db
BANK_DIR=/srv/almanac-bank
TLS_CERT=/etc/almanac/origin.pem
TLS_KEY=/etc/almanac/origin.key
TRUST_CLOUDFLARE=1
# 32+ random characters: openssl rand -base64 48
SECRET=
SMTP_URL=smtp://user:password@smtp.tem.scaleway.com:587
MAIL_FROM=АЛМАНАХ <no-reply@almanac.bg>
OPERATOR_NAME=
CONTACT_EMAIL=privacy@almanac.bg
ALERT_EMAIL=
# The mail policy at mta-sts.<domain>, while the _mta-sts TXT record points to it.
MTA_STS_MX=mail.protonmail.ch,mailsec.protonmail.ch
MTA_STS_MODE=testing
BACKUP_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
BACKUP_BUCKET=almanac-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_HEARTBEAT=
