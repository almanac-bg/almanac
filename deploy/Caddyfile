{
	# The certificate authorities' contact for this site (expiry notices; ZeroSSL, Caddy's second CA, needs one).
	email postmaster@{$DOMAIN}
	# Caddy's own log (a broken-off response is logged with its request) keeps no visitor: no address, no headers, no
	# query (where an unsubscribe key or a reset token can be) — the privacy policy says IPs aren't recorded (§2; the
	# 31 October review, LEGAL-8).
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
				request>uri regexp \?.* ""
			}
		}
	}
	servers {
		# Slow clients that never finish sending their headers don't hold connections open.
		timeouts {
			read_header 10s
		}
		# Cloudflare's proxy in front: a visitor's own address comes in CF-Connecting-IP, believed only from Cloudflare's
		# published ranges (https://www.cloudflare.com/ips; deploy/check.sh says when they change). From anywhere else
		# the address is the connection's own, whatever the request claims.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Every other address goes to https://{$DOMAIN}. Behind Cloudflare, an http:// one is sent to https:// at the edge first
# (Always Use HTTPS; the ACME path comes through), so http://www takes two steps unless the edge redirects www itself;
# without the proxy it's one step from each.
http://{$DOMAIN}, http://www.{$DOMAIN}, www.{$DOMAIN} {
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}

# MTA-STS (RFC 8461): mail to the domain's addresses (privacy@, abuse@, postmaster@) goes only over TLS, and only to
# these MX hosts — Proton Mail's (another mail provider: its own). Senders look for it only once the `_mta-sts` TXT
# record points to it (docs/self-hosting.md → Имейли). `testing` reports what would fail (to `_smtp._tls`'s address);
# `enforce`, after two clean weeks, refuses it — and the TXT record's id changes with every edit here.
mta-sts.{$DOMAIN} {
	header -Server
	header Content-Type "text/plain; charset=utf-8"
	respond /.well-known/mta-sts.txt <<POLICY
		version: STSv1
		mode: testing
		mx: mail.protonmail.ch
		mx: mailsec.protonmail.ch
		max_age: 604800
		POLICY 200
	respond 404
}

{$DOMAIN} {
	encode zstd gzip
	header {
		# Browsers remember to use HTTPS only (two years), here and on any subdomain. HSTS_PRELOAD="; preload" in .env
		# adds the directive the browsers' preload list asks for (almanac.bg is submitted, still pending on 2 November:
		# once the browsers ship it, HTTPS even on a first visit; hstspreload.org/api/v2/status?domain=almanac.bg).
		Strict-Transport-Security "max-age=63072000; includeSubDomains{$HSTS_PRELOAD}"
		-Server
	}
	# The app's port is published on the server's loopback only (Caddy runs on the host network). It hears the visitor's
	# address alone ({client_ip}, worked out above), never a chain the request brought along.
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Forwarded-For {client_ip}
	}

	# The few seconds the app restarts during a deploy: a friendly page that retries by itself, not a bare 502.
	handle_errors 502 503 504 {
		header Cache-Control "no-store"
		header Retry-After "10"
		@api path /api/* /socket.io/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"error":"Обновяваме играта — опитай след няколко секунди."}` 503
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
				<!doctype html>
				<html lang="bg">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="5">
				<title>Обновяваме АЛМАНАХ</title>
				<style>
				body{margin:0;min-height:100vh;display:grid;place-items:center;background:#07060d;color:#f5f3ff;font-family:"Segoe UI",Roboto,Arial,sans-serif;text-align:center;padding:24px}
				h1{font-size:24px;margin:24px 0 8px}p{color:#b3aed0;margin:0}.lockup{display:block;margin:0 auto;height:34px;width:auto}
				@media (prefers-color-scheme:light){body{background:#f4f3f9;color:#16131f}p{color:#4a4462}.petal{fill:#6d28d9}.gold{fill:#f59e0b}}
				</style>
				</head>
				<body><div><!--lockup--><svg xmlns="http://www.w3.org/2000/svg" class="lockup" role="img" aria-label="АЛМАНАХ" viewBox="0 0 8260 950"><g transform="scale(20.2128) translate(-8.5 -8.5)"><path class="gold" fill="#fbbf24" d="M32 30.2C24.5 24.7 21.5 14.7 26 9.9c3.2-3.4 8.8-3.4 12 0 4.5 4.8 1.5 14.8-6 20.3z" transform="rotate(-45 32 32)"/><path class="petal" fill="#c4b5fd" d="M32 30.2C24.5 24.7 21.5 14.7 26 9.9c3.2-3.4 8.8-3.4 12 0 4.5 4.8 1.5 14.8-6 20.3z" transform="rotate(45 32 32)"/><path class="petal" fill="#c4b5fd" d="M32 30.2C24.5 24.7 21.5 14.7 26 9.9c3.2-3.4 8.8-3.4 12 0 4.5 4.8 1.5 14.8-6 20.3z" transform="rotate(135 32 32)"/><path class="petal" fill="#c4b5fd" d="M32 30.2C24.5 24.7 21.5 14.7 26 9.9c3.2-3.4 8.8-3.4 12 0 4.5 4.8 1.5 14.8-6 20.3z" transform="rotate(225 32 32)"/></g><path fill="currentColor" d="M1488,724L1488,519L1999,519L1999,724L1488,724ZM1920,100L2249,850L1974,850L1715,214L1781,214L1522,850L1247,850L1576,100L1920,100ZM2406,100L3180,100L3180,850L2922,850L2922,212L3038,328L2550,328L2658,244Q2665,299 2668,351Q2670,403 2670,450Q2670,597 2643,689Q2615,781 2556,824Q2497,867 2402,867Q2358,867 2315,858Q2272,848 2237,830L2237,618Q2282,635 2319,635Q2378,635 2403,584Q2428,532 2428,413Q2428,351 2423,274Q2417,197 2406,100ZM4430,100L4430,850L4185,850L4185,197L4232,203L3980,850L3725,850L3473,206L3520,199L3520,850L3275,850L3275,100L3674,100L3898,711L3809,711L4031,100L4430,100ZM4703,724L4703,519L5214,519L5214,724L4703,724ZM5135,100L5464,850L5189,850L4930,214L4996,214L4737,850L4462,850L4791,100L5135,100ZM5496,100L5754,100L5754,850L5496,850L5496,100ZM6074,100L6332,100L6332,850L6074,850L6074,100ZM5642,353L6175,353L6175,581L5642,581L5642,353ZM6605,724L6605,519L7116,519L7116,724L6605,724ZM7037,100L7366,850L7091,850L6832,214L6898,214L6639,850L6364,850L6693,100L7037,100ZM7894,540L7894,381L8274,850L7957,850L7733,553L7863,553L7637,850L7324,850L7707,381L7707,540L7343,100L7666,100L7868,367L7738,367L7936,100L8255,100L7894,540Z"/></svg><!--/lockup--><h1>Обновяваме играта