{
	# The certificate authorities' contact for this site (expiry notices; ZeroSSL, Caddy's second CA, needs one).
	email postmaster@{$DOMAIN}
	servers {
		# Slow clients that never finish sending their headers don't hold connections open.
		timeouts {
			read_header 10s
		}
		# Cloudflare's proxy in front: a visitor's own address comes in CF-Connecting-IP, believed only from Cloudflare's
		# published ranges (https://www.cloudflare.com/ips; deploy/check.sh says when they change). From anywhere else
		# the address is the connection's own, whatever the request claims.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Every other address goes straight to https://{$DOMAIN} in one step (not http → https://www → apex).
http://{$DOMAIN}, http://www.{$DOMAIN}, www.{$DOMAIN} {
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		# Browsers remember to use HTTPS only (two years), here and on any subdomain. HSTS_PRELOAD="; preload" in .env
		# adds the directive the browsers' preload list asks for (almanac.bg is on it: HTTPS even on a first visit).
		Strict-Transport-Security "max-age=63072000; includeSubDomains{$HSTS_PRELOAD}"
		-Server
	}
	# The app's port is published on the server's loopback only (Caddy runs on the host network). It hears the visitor's
	# address alone ({client_ip}, worked out above), never a chain the request brought along.
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Forwarded-For {client_ip}
	}

	# The few seconds the app restarts during a deploy: a friendly page that retries by itself, not a bare 502.
	handle_errors 502 503 504 {
		header Cache-Control "no-store"
		header Retry-After "10"
		@api path /api/* /socket.io/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"error":"Обновяваме играта — опитай след няколко секунди."}` 503
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
				<!doctype html>
				<html lang="bg">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="5">
				<title>Обновяваме АЛМАНАХ</title>
				<style>
				body{margin:0;min-height:100vh;display:grid;place-items:center;background:#07060d;color:#f5f3ff;font-family:system-ui,sans-serif;text-align:center;padding:24px}
				h1{font-size:28px;margin:16px 0 8px}p{color:#b3aed0;margin:0}
				</style>
				</head>
				<body><div><div style="font-size:48px">⚡</div><h1>Обновяваме играта</h1><p>Връщаме се след няколко секунди — страницата ще се презареди сама.</p></div></body>
				</html>
				HTML 503
		}
	}
}
