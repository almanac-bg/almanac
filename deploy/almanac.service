# The game, as a service: one program, its own user, and nothing it doesn't need (systemd-analyze security almanac).
# It serves on the port almanac.socket holds for it, which keeps connections waiting while it restarts.
[Unit]
Description=АЛМАНАХ (almanac.bg)
After=network-online.target almanac.socket
Wants=network-online.target
Requires=almanac.socket

[Service]
User=almanac
Group=almanac
EnvironmentFile=/etc/almanac/env
WorkingDirectory=/var/lib/almanac
ExecStart=/usr/local/bin/almanac serve
# SIGHUP reloads the question bank (deploy/bank.sh).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# One that keeps failing is started again ever more slowly, up to a minute apart (a deploy's restart starts the count
# over). A crash soon after a deploy goes back to the version before (deploy.sh).
RestartSteps=5
RestartMaxDelaySec=60
# Requests under way get 30 seconds to finish, and what follows the games they ended the rest of it (one cut off is
# the sweep's after the restart: server.go).
TimeoutStopSec=45

# Memory, of the machine's 3.8 GB: the program's heap kept under 2 GiB (Go collects harder as it nears that), and the
# whole service, the database's pages in memory included, slowed and its cache given back past 2.6 GB, and stopped
# (then started again) past 3 GB, before the kernel would pick a process of the machine's to end, ssh's say.
Environment=GOMEMLIMIT=2GiB
MemoryHigh=2600M
MemoryMax=3G

# No privilege at all: the port comes from the socket.
CapabilityBoundingSet=
NoNewPrivileges=yes

# Everything read-only but its own directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/almanac
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
