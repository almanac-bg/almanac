<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App.entitlements for a Release build (TestFlight, the App Store): Apple's production push service. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Links to almanac.bg open in the app (the site's /.well-known/apple-app-site-association says which). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:almanac.bg</string>
	</array>
</dict>
</plist>
