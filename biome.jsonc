// Formatting, linting and import order for the whole repository: `npm run lint` checks, `npm run format` fixes.
// The settings match the style the code was written in.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/package-lock.json",
      // The question banks keep one question per line (easy to review and to diff).
      "!apps/server/src/data/*.json",
      "!apps/web/public",
      // Claude Code skills open with YAML front matter, which the Markdown formatter doesn't know.
      "!.claude/skills/**/*.md",
      // Workflow scripts run in Claude Code's workflow runtime (a top-level `return`), not as modules.
      "!.claude/skills/**/workflows/*.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // `!` marks values the code has already made sure of (a row just read, a player in their own match).
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
