    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
