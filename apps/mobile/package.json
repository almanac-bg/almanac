{
  "name": "@almanac/mobile",
  "version": "1.4.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__",
    "test": "jest",
    "bundle": "expo export --platform ios --platform android --output-dir dist --no-minify --source-maps",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.67.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^@almanac/client/realtime$": "<rootDir>/../../packages/client/src/realtime.ts",
      "^@almanac/(shared|client)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^(react|zustand|socket\\.io-client)(/.*)?$": "<rootDir>/node_modules/$1$2"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/__tests__/setup/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup/native.ts"
    ]
  }
}
