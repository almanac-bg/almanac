{
  "cli": {
    "version": ">= 27.4.0",
    "appVersionSource": "remote",
    "requireCommit": true,
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "extends": "preview",
      "developmentClient": true
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "24.22.2",
      "autoIncrement": true
    }
  }
}
