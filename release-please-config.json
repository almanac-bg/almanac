{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore(release): ${version}",
  "pull-request-header": "A release, ready when you are: merging this pull request tags the version and publishes its release, and the commit is what gets deployed (docs/maintainers.md → Издания).",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "almanac",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/client/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/shared/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mobile/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mobile/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/mobile/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/web'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/server'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/client'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/shared'].version" }
      ]
    }
  }
}
